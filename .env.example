# ── Rails ────────────────────────────────────────────────────────
RAILS_ENV=development
PORT=3000
APP_HOST=http://localhost:3000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECRET_KEY_BASE=change-me-run-rails-secret

# ── Database (PostgreSQL) ────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=tailor_tech_development
TEST_DATABASE_NAME=tailor_tech_test

# ── Redis / Sidekiq ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
SIDEKIQ_CONCURRENCY=5
SIDEKIQ_WEB_USER=
SIDEKIQ_WEB_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────────
JWT_SECRET=change-me-too
JWT_TTL_HOURS=336

# ── Active Storage ───────────────────────────────────────────────
# local | amazon
ACTIVE_STORAGE_SERVICE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=tailortech-design-assets
# Optional CloudFront distribution in front of the bucket
CDN_HOST=

# ── Python AI service (FastAPI) ──────────────────────────────────
# Set to true once the Python service is running; while false the backend
# falls back to library assets instead of calling out.
AI_SERVICE_ENABLED=false
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT=60

# ── Layer rendering engine ───────────────────────────────────────
PREVIEW_CACHE_TTL_SECONDS=3600
